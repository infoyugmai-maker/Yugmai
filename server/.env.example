# ============================================================
# YUGM AI server config template — copy to .env and fill in.
# Never commit the real .env.
# ============================================================

PORT=3000

# --- NVIDIA Nemotron (UMAI chatbot) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Supabase (file storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=files

# --- Resend (transactional email) ---
RESEND_API_KEY=
ADMIN_EMAIL=
MAIL_FROM=YUGM AI <onboarding@resend.dev>

# --- Firebase Admin SDK ---
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
FIREBASE_PROJECT_ID=

# --- Google Drive API (for NDA/invoice uploads) ---
DRIVE_ROOT_FOLDER_ID=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@yugmai.in

# --- reCAPTCHA ---
RECAPTCHA_SECRET_KEY=
