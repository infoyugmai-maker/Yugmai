rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Project files — any authenticated user can read, only admins can write
    match /projects/{projectId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // User uploads (invoices, NDAs, CVs) — owner can read/write, admins can read
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Public assets (logos, images) — anyone can read, admins can write
    match /public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
